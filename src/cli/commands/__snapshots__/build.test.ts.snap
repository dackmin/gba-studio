    ): if_expression(type_),
       op(op_),
       left(left_),
       right(right_) {}
  };

  struct if_event: event
  {
    int conditions_count;
    const if_condition* const* conditions;
    int then_events_count;
    const event* const* then_events;
    int else_events_count;
    const event* const* else_events;

    constexpr if_event(
      event_type type_,
