  const neo::types::scene& get_scene(bn::string_view name)
  {
    if (name == "") return scene_default;
    if (name == "Scene 0" || name == "d2a023cc-364d-4caf-9638-78937f593e4d") return scene_scene_0;
    if (name == "Point & Click" || name == "7c2d9a41-3b6e-4f5a-8e21-9a4c1d7e5b12") return scene_point_and_click;
