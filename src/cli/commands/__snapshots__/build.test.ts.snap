  struct sensor
  {
    bn::string_view _id;
    int x;
    int y;
    int width;
    int height;
    int enter_events_count;
    const event* const* enter_events;
    int leave_events_count;
    const event* const* leave_events;
    int interact_events_count;
    const event* const* interact_events;

    inline bool is_inside (int tile_x, int tile_y) const {
      return tile_x >= x && tile_x < (x + width) && tile_y >= y && tile_y < (y + height);
    }
  };

  struct map
  {
    int width;
    int height;
    const event_value* grid_size;
    const int* collisions;
    int sensors_count;
    const sensor* const* sensors;

    inline int to_pixel_x (neo::variables::registry& variables, int tile_x) const
    {
      return tile_x * grid_size->as_int(variables);
    }

    inline int to_tile_x (neo::variables::registry& variables, int pixel_x) const
    {
      return pixel_x / grid_size->as_int(variables);
    }

    inline int to_pixel_y (neo::variables::registry& variables, int tile_y) const
    {
      return tile_y * grid_size->as_int(variables);
    }

    inline int to_tile_y (neo::variables::registry& variables, int pixel_y) const
    {
      return pixel_y / grid_size->as_int(variables);
    }

    inline int pixel_width (neo::variables::registry& variables) const
    {
      return width * grid_size->as_int(variables);
    }

    inline int pixel_height (neo::variables::registry& variables) const
    {
      return height * grid_size->as_int(variables);
    }

    inline int tile_index (int tile_x, int tile_y) const
    {
      return tile_y * width + tile_x;
    }

    inline int tile_value (int tile_x, int tile_y) const
    {
      if (tile_x < 0 || tile_x >= width || tile_y < 0 || tile_y >= height)
      {
        return 1;
      }

      return collisions != nullptr ? collisions[tile_index(tile_x, tile_y)] : 0;
    }

    inline bool has_collision (int tile_x, int tile_y) const
    {
      if (tile_x < 0 || tile_x >= width || tile_y < 0 || tile_y >= height)
      {
        return true;
      }

      return collisions != nullptr && collisions[tile_index(tile_x, tile_y)] == 1;
    }

    inline bool one_way_blocks (
      neo::variables::registry& variables, int tile_x, int tile_y,
      int old_left, int old_top, int old_right, int old_bottom
    ) const
    {
      int value = tile_value(tile_x, tile_y);

      if (value < 4 || value > 7)
      {
        return false;
      }

      int size = grid_size->as_int(variables);

      switch (value)
      {
        case 4:
          return old_bottom < tile_y * size;
        case 5:
          return old_top >= (tile_y + 1) * size;
        case 6:
          return old_right < tile_x * size;
        default:
          return old_left >= (tile_x + 1) * size;
      }
    }

    inline bool one_way_blocks_step (int tile_x, int tile_y, int step_x, int step_y) const
    {
      switch (tile_value(tile_x, tile_y))
      {
        case 4:
          return step_y > 0;
        case 5:
          return step_y < 0;
        case 6:
          return step_x > 0;
        case 7:
          return step_x < 0;
        default:
          return false;
      }
    }
  };

  struct sprite_animation_frame
  {
    int frame_index;
    const event_value* duration;
    bool reversed;
  };

  struct animation_playback
  {
    bool playing = false;
    int current_index = 0;
    int elapsed_frames = 0;
  };

  struct sprite_animation
  {
    bn::string_view _id;
    bn::string_view name;
    bn::string_view type;
    neo::types::direction direction;
    neo::types::animation_state state;
    bool loop;
    int frames_count;
    const sprite_animation_frame* const* frames;

    constexpr sprite_animation(
      bn::string_view _id_,
      bn::string_view name_,
      bn::string_view type_,
      neo::types::direction direction_,
      neo::types::animation_state state_,
      bool loop_,
      int frames_count_,
      const sprite_animation_frame* const* frames_
    ):
      _id(_id_),
      name(name_),
      type(type_),
      direction(direction_),
      state(state_),
      loop(loop_),
      frames_count(frames_count_),
      frames(frames_) {}

    // Shows the first frame and arms the animation; call once before the per-frame play() loop starts
    inline void reset (animation_playback& playback, bn::sprite_ptr sprite, bn::sprite_tiles_item* tiles) const
    {
      playback.playing = true;
      playback.current_index = 0;
      playback.elapsed_frames = 0;

      if (frames_count > 0)
      {
        sprite.set_tiles(tiles->create_tiles(frames[0]->frame_index));
      }
    }

    // Non-blocking: advances the animation by a single frame, call once per bn::core::update()
    inline void play (animation_playback& playback, bn::sprite_ptr sprite, bn::sprite_tiles_item* tiles, neo::variables::registry& variables) const
    {
      if (!playback.playing || frames_count <= 0)
      {
        return;
      }

      int wait_frames = frames[playback.current_index]->duration->as_int(variables) / 16;

      if (wait_frames < 1)
      {
        wait_frames = 1;
      }

      if (++playback.elapsed_frames < wait_frames)
      {
        return;
      }

      playback.elapsed_frames = 0;

      if (playback.current_index + 1 >= frames_count)
      {
        if (!loop)
        {
          playback.playing = false;
          return;
        }

        playback.current_index = 0;
      }
      else
      {
        ++playback.current_index;
      }

      sprite.set_tiles(tiles->create_tiles(frames[playback.current_index]->frame_index));
    }

    inline void stop (animation_playback& playback, bn::sprite_ptr sprite, bn::sprite_tiles_item* tiles) const
    {
      playback.playing = false;
      playback.current_index = 0;
      playback.elapsed_frames = 0;
      sprite.set_tiles(tiles->create_tiles(frames[0]->frame_index));
    }
  };

  struct actor
  {
    bn::string_view _id;
    bn::string_view name;
    const event_value* x;
    const event_value* y;
    const event_value* z;
    neo::types::direction direction;
    bn::sprite_item sprite;
    bool disable_direction_on_interact;
    int collision_group;
    int collision_x;
    int collision_y;
    int collision_width;
    int collision_height;
    const event_value* bounce;
    neo::types::bounce_direction bounce_direction;
    bool pass_through;
    int init_events_count;
    const event* const* init_events;
    int interact_events_count;
    const event* const* interact_events;
    int collide_events_count;
    const event* const* collide_events;
    int hit_events_count;
    const event* const* hit_events;
    int update_events_count;
    const event* const* update_events;
    int animations_count;
    const sprite_animation* const* animations;
  };

  struct sprite
  {
    bn::string_view _id;
    bn::string_view name;
    const event_value* x;
    const event_value* y;
    const event_value* z;
    bn::sprite_item sprite;
    int collision_group;
    int collision_x;
    int collision_y;
    int collision_width;
    int collision_height;
    int init_events_count;
    const event* const* init_events;
    int interact_events_count;
    const event* const* interact_events;
    int collide_events_count;
    const event* const* collide_events;
    int animations_count;
    const sprite_animation* const* animations;
  };

  // Screen-fixed sprite of a HUD: x/y are pixels from the top-left corner
  // of the screen, z is a 0-99 layer among the HUD sprites.
  struct hud_sprite
  {
    bn::string_view _id;
    bn::string_view name;
    int x;
    int y;
    int z;
    bn::sprite_item sprite;
  };

  struct text
  {
    bn::string_view _id;
    bn::string_view name;
    const event_value* content;
    int x;
    int y;
    const event_value* z;
    bn::color color;
    const bn::sprite_item* font;
  };

  struct hud
  {
    bn::string_view _id;
    bn::string_view name;
    int sprites_count;
    const hud_sprite* const* sprites;
    int texts_count;
    const text* const* texts;
    int init_events_count;
    const event* const* init_events;
    int update_events_count;
    const event* const* update_events;
  };

  struct script
  {
    bn::string_view _id;
    bn::string_view name;
    int events_count;
    const event* const* events;
    int parameters_count;
    const bn::string_view* parameters;
  };

  struct scene
  {
    // Scene
    bn::string_view _id;
    bn::string_view name;
    neo::types::scene_type scene_type;
    neo::types::background background;
    int event_count;
    const event* const* events;
    // Player
    bool has_player;
    const actor* player;
    // Map data
    const map* map_data;
    // Actors
    int actors_count;
    const actor* const* actors;
    // Sprites
    int sprites_count;
    const sprite* const* sprites;
    // Texts
    int texts_count;
    const text* const* texts;
    const hud* hud_data;
    bn::sprite_item cursor;
    // Gravity
    bool has_gravity;
    const event_value* gravity_force;
    const event_value* jump_height;
    // Shoot 'em all
    neo::types::scroll_direction scroll_direction;
    const event_value* scroll_speed;
    neo::types::player_axis player_axis;
    const event_value* player_inertia;

    inline bool is (bn::string_view name_) const
    {
      return _id == name_ || name == name_;
    }
  };
}

#endif
"
`;

