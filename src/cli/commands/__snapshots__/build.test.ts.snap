    if (name == "Point & Click" || name == "7c2d9a41-3b6e-4f5a-8e21-9a4c1d7e5b12") return scene_point_and_click;
    if (name == "Adventure" || name == "3e8f2b6a-91c4-4d07-b5a2-6d1f0c9e7a21") return scene_adventure;
