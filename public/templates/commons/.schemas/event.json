{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "event.json",
  "definitions": {
    "CharacterDirection": {
      "enum": ["up", "down", "left", "right"],
      "type": "string"
    },
    "Direction": {
      "enum": [
        "up", "down", "left", "right",
        "up_left", "up_right", "down_left", "down_right"
      ],
      "type": "string"
    },
    "DirectionPriority": {
      "enum": ["horizontal", "vertical"],
      "type": "string"
    },
    "DynamicVariableValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "const": "variable"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "DynamicValue": {
      "oneOf": [
        { "$ref": "#/definitions/DynamicVariableValue" }
      ]
    },
    "EventValue": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "$ref": "#/definitions/DynamicValue" }
      ]
    },
    "GameMenuChoice": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "events": {
          "items": {
            "$ref": "#/definitions/Event"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "text",
        "events"
      ]
    },
    "WaitEvent": {
      "properties": {
        "duration": { "$ref": "#/definitions/EventValue" },
        "type": {
          "const": "wait",
          "type": "string"
        }
      },
      "required": [
        "duration",
        "type"
      ],
      "type": "object"
    },
    "FadeEvent": {
      "properties": {
        "duration": { "$ref": "#/definitions/EventValue" },
        "type": {
          "enum": [
            "fade-in",
            "fade-out"
          ],
          "type": "string"
        }
      },
      "required": [
        "duration",
        "type"
      ],
      "type": "object"
    },
    "GoToEvent": {
      "properties": {
        "target": {
          "type": "string"
        },
        "start": {
          "type": "object",
          "properties": {
            "x": { "$ref": "#/definitions/EventValue" },
            "y": { "$ref": "#/definitions/EventValue" },
            "direction": { "$ref": "#/definitions/Direction" }
          }
        },
        "type": {
          "const": "go-to-scene",
          "type": "string"
        }
      },
      "required": [
        "target",
        "type"
      ],
      "type": "object"
    },
    "PlayMusicEvent": {
      "properties": {
        "name": {
          "type": "string"
        },
        "volume": {
          "type": "number"
        },
        "loop": {
          "type": "boolean"
        },
        "type": {
          "const": "play-music",
          "type": "string"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "type": "object"
    },
    "StopMusicEvent": {
      "properties": {
        "type": {
          "const": "stop-music",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "PlaySoundEvent": {
      "properties": {
        "name": {
          "type": "string"
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "speed": {
          "type": "number",
          "minimum": 0,
          "maximum": 64
        },
        "pan": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "priority": {
          "type": "number",
          "minimum": -32767,
          "maximum": 32767
        },
        "type": {
          "const": "play-sound",
          "type": "string"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "type": "object"
    },
    "WaitForButtonEvent": {
      "properties": {
        "every": {
          "type": "boolean"
        },
        "buttons": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "type": {
          "const": "wait-for-button",
          "type": "string"
        }
      },
      "required": [
        "buttons",
        "type"
      ],
      "type": "object"
    },
    "OnButtonPressEvent": {
      "properties": {
        "buttons": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "type": {
          "const": "on-button-press",
          "type": "string"
        },
        "events": {
          "items": {
            "$ref": "#/definitions/Event"
          },
          "type": "array"
        }
      },
      "required": [
        "buttons",
        "type"
      ],
      "type": "object"
    },
    "DisableInputEvent": {
      "properties": {
        "type": {
          "const": "disable-input",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "EnableInputEvent": {
      "properties": {
        "type": {
          "const": "enable-input",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "SetVariableEvent": {
      "properties": {
        "name": {
          "type": "string"
        },
        "value": { "$ref": "#/definitions/EventValue" },
        "type": {
          "const": "set-variable",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value",
        "type"
      ],
      "type": "object"
    },
    "ShowDialogEvent": {
      "properties": {
        "text": {
          "type": "string"
        },
        "direction": { "$ref": "#/definitions/Direction" },
        "z": {
          "type": "number"
        },
        "speed": {
          "enum": [
            "slow",
            "normal",
            "fast"
          ],
          "type": "string"
        },
        "type": {
          "const": "show-dialog",
          "type": "string"
        }
      },
      "required": [
        "text",
        "type"
      ],
      "type": "object"
    },
    "DisableActorEvent": {
      "properties": {
        "actor": {
          "type": "string"
        },
        "type": {
          "const": "disable-actor",
          "type": "string"
        }
      },
      "required": [
        "actor",
        "type"
      ],
      "type": "object"
    },
    "EnableActorEvent": {
      "properties": {
        "actor": {
          "type": "string"
        },
        "type": {
          "const": "enable-actor",
          "type": "string"
        }
      },
      "required": [
        "actor",
        "type"
      ],
      "type": "object"
    },
    "MoveCameraToEvent": {
      "properties": {
        "x": { "$ref": "#/definitions/EventValue" },
        "y": { "$ref": "#/definitions/EventValue" },
        "duration": { "$ref": "#/definitions/EventValue" },
        "allowDiagonal": {
          "type": "boolean"
        },
        "directionPriority": { "$ref": "#/definitions/DirectionPriority" },
        "type": {
          "const": "move-camera-to",
          "type": "string"
        }
      },
      "required": [
        "x",
        "y",
        "type"
      ],
      "type": "object"
    },
    "FollowActorEvent": {
      "properties": {
        "actor": {
          "type": "string"
        },
        "duration": { "$ref": "#/definitions/EventValue" },
        "allowDiagonal": {
          "type": "boolean"
        },
        "directionPriority": { "$ref": "#/definitions/DirectionPriority" },
        "type": {
          "const": "follow-actor",
          "type": "string"
        }
      },
      "required": [
        "actor",
        "type"
      ],
      "type": "object"
    },
    "FollowPlayerEvent": {
      "properties": {
        "duration": { "$ref": "#/definitions/EventValue" },
        "allowDiagonal": {
          "type": "boolean"
        },
        "directionPriority": { "$ref": "#/definitions/DirectionPriority" },
        "type": {
          "const": "follow-player",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "FreezeCameraEvent": {
      "properties": {
        "type": {
          "const": "freeze-camera",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "MoveActorToEvent": {
      "properties": {
        "actor": {
          "type": "string"
        },
        "x": { "$ref": "#/definitions/EventValue" },
        "y": { "$ref": "#/definitions/EventValue" },
        "speed": { "$ref": "#/definitions/EventValue" },
        "directionPriority": { "$ref": "#/definitions/DirectionPriority" },
        "animation": {
          "type": "string"
        },
        "type": {
          "const": "move-actor-to",
          "type": "string"
        }
      },
      "required": [
        "actor",
        "x",
        "y",
        "type"
      ],
      "type": "object"
    },
    "ShowMenuEvent": {
      "properties": {
        "choices": {
          "items": {
            "$ref": "#/definitions/GameMenuChoice"
          },
          "type": "array"
        },
        "direction": { "$ref": "#/definitions/Direction" },
        "z": {
          "type": "number"
        },
        "type": {
          "const": "show-menu",
          "type": "string"
        }
      },
      "required": [
        "choices",
        "type"
      ],
      "type": "object"
    },
    "IfEvent": {
      "properties": {
        "then": {
          "items": {
            "$ref": "#/definitions/Event"
          },
          "type": "array"
        },
        "else": {
          "items": {
            "$ref": "#/definitions/Event"
          },
          "type": "array"
        },
        "conditions": {
          "items": {
            "$ref": "condition.json#/definitions/IfEventCondition"
          },
          "type": "array"
        },
        "type": {
          "const": "if",
          "type": "string"
        }
      },
      "required": [
        "conditions",
        "type"
      ],
      "type": "object"
    },
    "ExecuteScriptEvent": {
      "properties": {
        "script": {
          "type": "string"
        },
        "type": {
          "const": "execute-script",
          "type": "string"
        }
      },
      "required": [
        "script",
        "type"
      ],
      "type": "object"
    },
    "SetActorDirectionEvent": {
      "properties": {
        "actor": {
          "type": "string"
        },
        "direction": { "$ref": "#/definitions/CharacterDirection" },
        "type": {
          "const": "set-actor-direction",
          "type": "string"
        }
      },
      "required": [
        "actor",
        "direction",
        "type"
      ],
      "type": "object"
    },
    "SetBackgroundEvent": {
      "properties": {
        "background": {
          "type": "string"
        },
        "type": {
          "const": "set-background",
          "type": "string"
        }
      },
      "required": [
        "background",
        "type"
      ],
      "type": "object"
    },
    "Event": {
      "anyOf": [
        { "$ref": "#/definitions/WaitEvent" },
        { "$ref": "#/definitions/FadeEvent" },
        { "$ref": "#/definitions/GoToEvent" },
        { "$ref": "#/definitions/PlayMusicEvent" },
        { "$ref": "#/definitions/StopMusicEvent" },
        { "$ref": "#/definitions/PlaySoundEvent" },
        { "$ref": "#/definitions/WaitForButtonEvent" },
        { "$ref": "#/definitions/OnButtonPressEvent" },
        { "$ref": "#/definitions/DisableInputEvent" },
        { "$ref": "#/definitions/EnableInputEvent" },
        { "$ref": "#/definitions/SetVariableEvent" },
        { "$ref": "#/definitions/ShowDialogEvent" },
        { "$ref": "#/definitions/DisableActorEvent" },
        { "$ref": "#/definitions/EnableActorEvent" },
        { "$ref": "#/definitions/MoveCameraToEvent" },
        { "$ref": "#/definitions/FollowActorEvent" },
        { "$ref": "#/definitions/FollowPlayerEvent" },
        { "$ref": "#/definitions/FreezeCameraEvent" },
        { "$ref": "#/definitions/MoveActorToEvent" },
        { "$ref": "#/definitions/ShowMenuEvent" },
        { "$ref": "#/definitions/IfEvent" },
        { "$ref": "#/definitions/ExecuteScriptEvent" },
        { "$ref": "#/definitions/SetActorDirectionEvent" },
        { "$ref": "#/definitions/SetBackgroundEvent" }
      ]
    }
  },
  "$ref": "#/definitions/Event"
}
