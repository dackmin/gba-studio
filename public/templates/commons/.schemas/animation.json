{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "animation.json",
  "definitions": {
    "AnimationFrame": {
      "type": "object",
      "required": ["type", "index"],
      "additionalProperties": false,
      "properties": {
        "duration": {
          "type": "number"
        },
        "index": {
          "oneOf": [
            { "type": "number" },
            { "type": "string" }
          ]
        },
        "type": {
          "const": "frame",
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      }
    },
    "AnimationState": {
      "type": "object",
      "required": ["type", "frames"],
      "additionalProperties": false,
      "properties": {
        "frames": {
          "type": "array",
          "items": { "$ref": "#/definitions/AnimationFrame" }
        },
        "type": {
          "const": "state",
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      }
    },
    "Animation": {
      "type": "object",
      "required": ["type", "name", "animationType"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "animation",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "animationType": {
          "enum": [
            "fixed",
            "movements",
            "directions"
          ],
          "type": "string"
        },
        "states": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fixed": {
              "$ref": "#/definitions/AnimationState"
            },
            "moving": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "up": { "$ref": "#/definitions/AnimationState" },
                "down": { "$ref": "#/definitions/AnimationState" },
                "left": { "$ref": "#/definitions/AnimationState" },
                "right": { "$ref": "#/definitions/AnimationState" }
              }
            },
            "idle": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "up": { "$ref": "#/definitions/AnimationState" },
                "down": { "$ref": "#/definitions/AnimationState" },
                "left": { "$ref": "#/definitions/AnimationState" },
                "right": { "$ref": "#/definitions/AnimationState" }
              }
            }
          }
        },
        "id": {
          "type": "string"
        }
      }
    },
    "Animations": {
      "type": "object",
      "required": ["type", "animations"],
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "type": {
          "const": "animations",
          "type": "string"
        },
        "animations": {
          "type": "array",
          "items": { "$ref": "#/definitions/Animation" }
        }
      }
    }
  },
  "$ref": "#/definitions/Animations"
}
