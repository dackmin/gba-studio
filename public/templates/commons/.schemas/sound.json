{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "sound.json",
  "definitions": {
    "Sound": {
      "type": "object",
      "required": ["type", "name", "format", "path"],
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "sound"
        },
        "name": {
          "type": "string"
        },
        "format": {
          "type": "string",
          "enum": ["wav"]
        },
        "path": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      }
    }
  },
  "$ref": "#/definitions/Sound"
}
