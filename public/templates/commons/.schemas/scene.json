{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "scene.json",
  "definitions": {
    "CharacterDirection": {
      "enum": [
        "down",
        "left",
        "right",
        "up"
      ],
      "type": "string"
    },
    "Actor": {
      "type": "object",
      "properties": {
        "type": {
          "const": "actor",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "direction": {
          "$ref": "#/definitions/CharacterDirection"
        },
        "sprite": {
          "type": "string"
        },
        "events": {
          "additionalProperties": false,
          "properties": {
            "interact": {
              "type": "array",
              "items": {
                "$ref": "event.json#/definitions/Event"
              }
            },
            "init": {
              "type": "array",
              "items": {
                "$ref": "event.json#/definitions/Event"
              }
            },
            "update": {
              "type": "array",
              "items": {
                "$ref": "event.json#/definitions/Event"
              }
            }
          },
          "type": "object"
        }
      },
      "required": [
        "type",
        "name",
        "sprite"
      ]
    },
    "Scene": {
      "properties": {
        "$schema": {
          "type": "string"
        },
        "sceneType": {
          "type": "string"
        },
        "background": {
          "type": "string"
        },
        "events": {
          "items": {
            "$ref": "event.json#/definitions/Event"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "player": {
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "direction": {
              "$ref": "#/definitions/CharacterDirection"
            }
          },
          "required": [
            "x",
            "y"
          ],
          "type": "object"
        },
        "actors": {
          "type": "array",
          "items": { "$ref": "#/definitions/Actor" }
        },
        "map": {
          "$ref": "#/definitions/Map"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "$schema",
        "type",
        "name",
        "events"
      ],
      "type": "object"
    },
    "Map": {
      "type": "object",
      "properties": {
        "type": {
          "const": "map",
          "type": "string"
        },
        "scene": {
          "type": "string"
        },
        "gridSize": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "collisions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sensors": {
          "type": "array",
          "items": {
            "properties": {
              "type": {
                "const": "sensor",
                "type": "string"
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              },
              "events": {
                "type": "array",
                "items": {
                  "$ref": "event.json#/definitions/Event"
                }
              }
            },
            "required": [
              "type",
              "x",
              "y",
              "events"
            ],
            "type": "object"
          }
        }
      },
      "required": [
        "type",
        "scene",
        "gridSize",
        "width",
        "height"
      ]
    }
  },
  "$ref": "#/definitions/Scene"
}
