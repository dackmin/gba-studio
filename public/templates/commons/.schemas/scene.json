{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "scene.json",
  "definitions": {
    "CharacterDirection": {
      "enum": [
        "down",
        "left",
        "right",
        "up"
      ],
      "type": "string"
    },
    "Actor": {
      "type": "object",
      "properties": {
        "type": {
          "const": "actor",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "direction": {
          "$ref": "#/definitions/CharacterDirection"
        },
        "sprite": {
          "type": "string"
        },
        "disableDirectionOnInteract": {
          "type": "boolean"
        },
        "events": {
          "additionalProperties": false,
          "properties": {
            "interact": {
              "type": "array",
              "items": {
                "$ref": "event.json#/definitions/Event"
              }
            },
            "init": {
              "type": "array",
              "items": {
                "$ref": "event.json#/definitions/Event"
              }
            },
            "update": {
              "type": "array",
              "items": {
                "$ref": "event.json#/definitions/Event"
              }
            }
          },
          "type": "object"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "name",
        "x",
        "y",
        "sprite"
      ]
    },
    "Sensor": {
      "type": "object",
      "properties": {
        "type": {
          "const": "sensor",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "event.json#/definitions/Event"
          }
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "name",
        "x",
        "y",
        "width",
        "height"
      ]
    },
    "Sprite": {
      "type": "object",
      "properties": {
        "type": {
          "const": "sprite",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "sprite": {
          "type": "string"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "events": {
          "additionalProperties": false,
          "properties": {
            "init": {
              "type": "array",
              "items": {
                "$ref": "event.json#/definitions/Event"
              }
            },
            "interact": {
              "type": "array",
              "items": {
                "$ref": "event.json#/definitions/Event"
              }
            }
          },
          "type": "object"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "name",
        "sprite",
        "x",
        "y"
      ]
    },
    "Player": {
      "type": "object",
      "properties": {
        "type": {
          "const": "player",
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "direction": {
          "$ref": "#/definitions/CharacterDirection"
        },
        "sprite": {
          "type": "string"
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "Scene": {
      "properties": {
        "$schema": {
          "type": "string"
        },
        "sceneType": {
          "enum": ["logos", "2d-top-down"],
          "type": "string"
        },
        "background": {
          "type": "string"
        },
        "events": {
          "items": {
            "$ref": "event.json#/definitions/Event"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "player": {
          "$ref": "#/definitions/Player"
        },
        "actors": {
          "type": "array",
          "items": { "$ref": "#/definitions/Actor" }
        },
        "sprites": {
          "type": "array",
          "items": { "$ref": "#/definitions/Sprite" }
        },
        "map": {
          "$ref": "#/definitions/Map"
        },
        "type": {
          "const": "scene",
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "$schema",
        "type",
        "sceneType",
        "name"
      ],
      "type": "object"
    },
    "Map": {
      "type": "object",
      "properties": {
        "type": {
          "const": "map",
          "type": "string"
        },
        "scene": {
          "type": "string"
        },
        "gridSize": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "collisions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sensors": {
          "type": "array",
          "items": { "$ref": "#/definitions/Sensor" }
        }
      },
      "required": [
        "type",
        "gridSize",
        "width",
        "height"
      ]
    }
  },
  "$ref": "#/definitions/Scene"
}
