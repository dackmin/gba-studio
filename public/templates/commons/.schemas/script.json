{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "script.json",
  "definitions": {
    "Script": {
      "additionalProperties": false,
      "properties": {
        "$schema": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "type": {
          "const": "script",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "parameters": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "type"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "type": { "enum": ["value", "variable", "actor"], "type": "string" }
            }
          }
        },
        "events": {
          "items": {
            "$ref": "event.json#/definitions/Event"
          },
          "type": "array"
        }
      },
      "required": [
        "$schema",
        "type",
        "name"
      ]
    }
  },
  "$ref": "#/definitions/Script"
}
