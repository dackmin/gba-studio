{
  "$schema": "https://raw.githubusercontent.com/dackmin/gba-studio/main/public/templates/commons/.schemas/script.json",
  "type": "script",
  "name": "Log Twice",
  "id": "script-log-twice",
  "events": [
    {
      "type": "set-variable",
      "name": "counter",
      "operation": "increment",
      "value": 1
    },
    {
      "type": "plugin:log-message:log",
      "params": {
        "message": "First log"
      }
    },
    {
      "type": "set-variable",
      "name": "counter",
      "operation": "increment",
      "value": 1
    },
    {
      "type": "plugin:log-message:log",
      "params": {
        "message": "Second log"
      }
    }
  ]
}
